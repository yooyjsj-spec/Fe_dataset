{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "웹 테스트 페이지 열기",
      "type": "shell",
      "command": "npx --yes serve -l 8000 .",
      "isBackground": true,
      "problemMatcher": {
        "owner": "serve",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Accepting connections|Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
